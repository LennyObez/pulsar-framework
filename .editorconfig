# Pulsar Framework — EditorConfig
#
# Universal editor configuration enforcing the same baseline regardless of
# IDE/editor (VS Code, JetBrains, Vim, Emacs, Sublime, Helix, etc.).
# https://editorconfig.org/

root = true

# Default: UTF-8 + LF + final newline + no trailing whitespace + 4-space indent
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Rust — 4 spaces, 100-col max (matches rustfmt.toml)
[*.rs]
indent_size = 4
max_line_length = 100

# TOML — 4 spaces (Cargo convention)
[*.toml]
indent_size = 4

# YAML — 2 spaces (GitHub Actions + Kubernetes convention)
[*.{yml,yaml}]
indent_size = 2

# JSON — 2 spaces
[*.json]
indent_size = 2

# Shell — 4 spaces
[*.sh]
indent_size = 4

# Web assets (services/admin/) — 2 spaces (web ecosystem convention)
[*.{html,css,js,mjs,ts}]
indent_size = 2
max_line_length = 100

# Markdown — 2 spaces, no trailing-whitespace trim (MD line-break syntax uses double-space)
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 0

# Templates
[*.pulse]
indent_size = 2

# TLA+ specs
[*.tla]
indent_size = 2

# Go (services/operator/) — tabs (Go convention)
[*.go]
indent_style = tab
indent_size = 4

# Makefile — tabs (mandatory per make syntax)
[Makefile]
indent_style = tab

# Generated files — leave alone
[Cargo.lock]
insert_final_newline = unset
trim_trailing_whitespace = unset
