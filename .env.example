# ==========================================================================
# F19.4: this template is the LOCAL-development starting point.
# Copy to `.env`, then BEFORE deploying to staging/production:
#   - flip APP_DEBUG to `false`
#   - flip APP_ENV to `staging` or `production`
#   - regenerate APP_KEY and PULSAR_MASTER_KEY for the target env
# `composer deploy:check` enforces these (DebugModeCheck +
# DeploySeverity defaults), so a deploy with APP_DEBUG=true in
# production fails the gate.
# ==========================================================================
# Application
# ==========================================================================
APP_NAME=Pulsar
# APP_ENV selects the runtime posture. Accepted values (anything unrecognized is
# treated as `production` — fail-secure: debug OFF, no stack-trace/source disclosure):
#   local       development machine — debug ON by default, verbose error pages
#   staging     pre-production — debug OFF by default, production-like posture
#   production  live — debug OFF by default, no source/stack disclosure
APP_ENV=local
# APP_DEBUG overrides the per-env default above. MUST be false in staging/production.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
# APP_DOMAIN — base application domain for multi-domain routing and cookie
# scoping (e.g. example.com). Leave unset to derive from the request host.
# APP_DOMAIN=

# ==========================================================================
# Security & Encryption
# ==========================================================================
# PULSAR_MASTER_KEY — the root secret (64-char hex / 32 bytes); every other key
# is derived from it. Generate with: php bin/pulsar key:generate --write
# Resolved through the Environment, so a value set here in .env is honoured by
# the application. For PRODUCTION prefer a real environment variable or secret
# manager over committing it to a file; `pulsar serve` exports it to the process
# environment automatically so every boot phase sees it in local development.
PULSAR_MASTER_KEY=
# PULSAR_MASTER_KEY_PREVIOUS — the previous key during rotation (decrypt-only);
# keep it until existing at-rest data has been re-encrypted, then remove it.
# PULSAR_MASTER_KEY_PREVIOUS=
# CACHE_ENCRYPT — encrypt the framework boot cache at rest (true/false; default false).
# CACHE_ENCRYPT=false
#
# Per-subsystem key OVERRIDES (opt-in, advanced). By default every subsystem key
# is derived from PULSAR_MASTER_KEY; set one of these to a hex key of the correct
# length to pin a specific subsystem — e.g. to rotate it independently. See
# docs/key-rotation.md.
# PULSAR_ENCRYPTION_KEY=   # overrides the encryption subsystem key (context encrypt_)
# PULSAR_AUDIT_KEY=        # overrides the audit-HMAC subsystem key (context audit___)
#
# PULSAR_DIAGNOSTICS_TOKEN — Bearer token gating /_pulsar/diagnostics and the
# metrics endpoint. Off by default: with no token set, the endpoint refuses every
# request. Set a high-entropy value to enable operator access.
# PULSAR_DIAGNOSTICS_TOKEN=
#
# PULSAR_VERIFY_ARTIFACTS — verify signed build artifacts (config/routes cache)
# at boot (1/true to enable). Read from the process/CI environment (a build-
# integrity gate), so set it in your deployment/CI environment, not only in .env.
# PULSAR_VERIFY_ARTIFACTS=false

# ==========================================================================
# Database
# ==========================================================================
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pulsar
# DB_USERNAME=root
# DB_PASSWORD=

# ==========================================================================
# Session
# ==========================================================================
# SESSION_COOKIE_NAME=PULSAR_SESSION
# SESSION_DOMAIN — cookie domain for the session cookie (e.g. .example.com to
# share it across subdomains). Leave unset to scope it to the current host.
# SESSION_DOMAIN=

# ==========================================================================
# Anti-Spam / CAPTCHA
# ==========================================================================
# External CAPTCHA keys (hCaptcha or Cloudflare Turnstile); required only when
# the anti-spam captcha check is enabled with a non-managed provider. The
# self-hosted "managed" challenge needs no keys. See docs/anti-spam.md.
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# ==========================================================================
# Queue
# ==========================================================================
# QUEUE_ENABLED=false
# QUEUE_DRIVER=sync

# ==========================================================================
# Storage
# ==========================================================================
# STORAGE_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ==========================================================================
# Logging & Audit
# ==========================================================================
# LOG_CHANNEL=file
# LOG_LEVEL=debug
# AUDIT_LOG_PATH=var/logs/audit.jsonl

# ==========================================================================
# Studio (Development Dashboard)
# ==========================================================================
# STUDIO_ENABLED=false
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8585
# STUDIO_USERNAME=
# STUDIO_PASSWORD=
# STUDIO_STORAGE_PATH=
# STUDIO_SAMPLING_RATE=1.0
# STUDIO_RETENTION_DAYS=7
# STUDIO_STORE_RAW_SQL=false
# STUDIO_PRODUCTION_CONFIRM=false

# ==========================================================================
# Interactive REPL
# ==========================================================================
# REPL_ENABLED=false

# ==========================================================================
# Feature Flags & Optional Subsystems
# ==========================================================================
# FEATURE_FLAGS_ENABLED=false
# TENANCY_ENABLED=false
# SCHEDULER_ENABLED=false
# SUPERVISOR_ENABLED=false
# INTEGRITY_ENABLED=false
# RESILIENCE_ENABLED=false
