# ==========================================================================
# F19.4: production-shaped starting point. Copy to `.env` on the
# target host BEFORE running the application; never commit a
# production `.env` to source control. Every secret here is a
# placeholder — fill in via your secrets manager (AWS SecretsManager,
# Google SecretManager, Azure KeyVault, HashiCorp Vault) or via
# manual provisioning. Do NOT reuse values from `.env.example`.
#
# `composer deploy:check` validates the values below at deploy time and
# exits non-zero on any error-severity result, so a pipeline that reads
# the exit code refuses the deploy. Two of the gates below are
# error-severity by default (`severity => 'fail'` in config/deploy.php):
# `debug-mode` when APP_DEBUG=true, and `master-key` when
# PULSAR_MASTER_KEY is empty or unusable. Verified by running it: with
# both conditions set, the command reports FAIL for both and exits 1.
# Add `--strict` to refuse the deploy on warnings as well.
# ==========================================================================
# Application
# ==========================================================================
APP_NAME=Pulsar
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
# Generate per-environment with: php bin/pulsar key:generate --write
APP_KEY=

# ==========================================================================
# Security & Encryption
# ==========================================================================
# Generate per-environment with: php bin/pulsar key:generate --write
#
# EMPTY MEANS OFF, NOT "SECURE DEFAULT". Every at-rest protection Pulsar has
# is derived from this key, and SecurityWiring registers all of it inside a
# single `if` on this value. Left empty, that branch never runs and nothing
# throws — the application boots and serves traffic while:
#
#   - no EncryptorInterface is bound  -> nothing encrypts application data at rest
#   - no SessionEncryption is bound   -> session payloads are stored unencrypted,
#                                        even though config/security.php still
#                                        says 'encryption' => true
#   - no audit HMAC chain is keyed    -> the audit trail is not tamper-evident
#   - no SecretVault / tokenization   -> PAN tokenization is unavailable
#
# A present but MALFORMED key is caught and discarded during wiring, leaving
# the deployment in exactly that state. `deploy:check` refuses both cases with
# a non-zero exit (the `master-key` gate, error severity); `pulsar
# compliance:report` reports the resulting gap control by control.
PULSAR_MASTER_KEY=
# Optional: previous key for rotation window
# PULSAR_MASTER_KEY_PREVIOUS=
CACHE_ENCRYPT=true

# ==========================================================================
# Database
# ==========================================================================
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ==========================================================================
# Session
# ==========================================================================
SESSION_COOKIE_NAME=PULSAR_SESSION
# SESSION_COOKIE_SECURE — the only session cookie setting read from the
# environment. It already defaults to true outside local/development; set it
# explicitly here so the intent is visible in the deployed file.
SESSION_COOKIE_SECURE=true
# HttpOnly and SameSite are NOT environment-tunable. They are fixed in
# config/security.php as `'cookie_httponly' => true` and
# `'cookie_samesite' => 'Strict'`. Earlier revisions of this template listed
# SESSION_HTTP_ONLY and SESSION_SAME_SITE=lax, which nothing read: the
# values were inert, and the advertised `lax` was never what was applied.
# Change these in config/security.php, where the change is reviewable.

# ==========================================================================
# Queue
# ==========================================================================
QUEUE_ENABLED=true
QUEUE_DRIVER=database

# ==========================================================================
# Storage
# ==========================================================================
STORAGE_DISK=local

# ==========================================================================
# Logging & Audit
# ==========================================================================
LOG_CHANNEL=file
LOG_LEVEL=info
AUDIT_LOG_PATH=var/logs/audit.jsonl

# ==========================================================================
# Studio — disabled in production
# ==========================================================================
STUDIO_ENABLED=false

# ==========================================================================
# REPL — disabled in production
# ==========================================================================
REPL_ENABLED=false

# ==========================================================================
# Feature Flags & Optional Subsystems
# ==========================================================================
FEATURE_FLAGS_ENABLED=false
TENANCY_ENABLED=false
SCHEDULER_ENABLED=true
SUPERVISOR_ENABLED=true
INTEGRITY_ENABLED=true
RESILIENCE_ENABLED=true
