# Pulsar Framework — Git attributes
#
# Per plan Section 14.6 SLSA Level 4 reproducibility requirement: every checkout
# on every platform must produce byte-identical files. LF-everywhere enforces
# that determinism.

# Default: LF for all text files; auto-detect binary
* text=auto eol=lf

# Source code — LF
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf

# Documentation — LF
*.md text eol=lf
*.rst text eol=lf

# Web assets (services/admin/) — LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf

# Templates — LF
*.pulse text eol=lf
*.tera text eol=lf
*.tla text eol=lf

# Shell scripts — LF (mandatory)
*.sh text eol=lf

# Go (services/operator/) — LF
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Configuration — LF
*.cfg text eol=lf
*.conf text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf

# Binary — never normalise
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary

# Cargo.lock — text but special — pre-line-based for diff readability
Cargo.lock text eol=lf merge=text

# GitHub-linguist hints (improve language stats)
*.tla linguist-language=TLA
*.pulse linguist-language=HTML
docs/architecture/diagrams/*.md linguist-detectable=true linguist-documentation=false
