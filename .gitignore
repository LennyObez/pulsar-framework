# OS / editor
.DS_Store
Thumbs.db
nul
.idea/
.vscode/
*.swp
*.swo
*.stackdump

# Audit working notes — kept local only, never published
docs/audit/

# PHP / Composer
/vendor/

# Isolated tool trees (bamarni/composer-bin-plugin). The manifest and lock of each
# tool ARE tracked, so the analyser version is pinned and reproducible; the packages
# they install are not. Note /vendor/ above is root-anchored and does not cover these.
/vendor-bin/*/vendor/
.phpunit.result.cache
.phpunit.cache/
.phpstan.cache/
.psalm/
.psalm-cache/
*.log

# Database
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal

# Runtime / app temp
/bootstrap/cache/
/storage/
/var/
/public/cms-assets/
tmp/
.cache/

# Node / tooling
node_modules/
dist/
extensions/cms/frontend/dist/
/build/
coverage/
# Default output of `pulsar vex`, written to the root unless -o says otherwise.
/vex.json
.eslintcache
.prettier-cache

# Env / secrets
.env
.env.*
!.env.example
!.env.production.example

# REPL history
.pulsar_repl_history

# REPL history
.pulsar_repl_history

# PHP-CS-Fixer cache
.php-cs-fixer.cache

# Deptrac cache
.deptrac.cache

# Internal / local-only agent instructions (keep out of GitHub)
CLAUDE.md
.claude/
.agents/
.codex/
AGENTS.md

# Working notes and handover records. They describe how the work was done rather than
# what the code is, and they name internal tooling — neither belongs in a public history.
# Deliberately not under docs/, which is published documentation.
.worklog/
docs/internal/

# tests/Support/ was in that list and should not have been: it holds test
# infrastructure, not notes. Ignoring it means a shared base class or trait added
# there is silently absent from CI, and every test extending it dies on an
# unresolvable class — a failure that reproduces nowhere locally, because locally the
# file is right there. FilesystemTestCase.php had already been sitting untracked.

# Generated by `pulsar preload:dump` next to the preload script it describes.
# Untracked build output: it fails `pnpm format:check` locally while CI, which
# checks out clean, never sees it — so the two disagree about a file nobody owns.
preload.generated.php
preload.generated.php.meta.json
