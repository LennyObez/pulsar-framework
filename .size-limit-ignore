# F387.M1 / ADR-0031 — paths excluded from the substantive-diff
# count enforced by tools/ci/check-pr-size.sh. One pathspec per
# line; `#` comments and blank lines are ignored.
#
# Rationale: lockfile updates, generated code, vendored fixtures,
# and pure rename diffs do not represent reviewer-load. They
# legitimately produce large diffs that should not push a PR
# over the 1500-line cap.

# Lock files (regenerated, not authored)
composer.lock
pnpm-lock.yaml
package-lock.json
yarn.lock

# Generated API snapshot (regenerated by composer api:snapshot)
tools/api/public-api.snapshot.json

# Pack scaffolds carry their own lockfiles
resources/packs/**/composer.lock
resources/packs/**/pnpm-lock.yaml
