#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Pulsar Framework CLI
 *
 * This is the entry point for the Pulsar command-line interface.
 */

// Find autoloader (supports development, installed, and symlinked scenarios)
// When installed via Composer path symlink (junction on Windows), __DIR__ resolves
// to the framework's own directory, not the project's. Use getcwd() first to find
// the project's vendor/autoload.php, then fall back to __DIR__-relative paths.
$autoloadPaths = [
  getcwd() . '/vendor/autoload.php',       // Project root (works with symlinks)
  __DIR__ . '/../vendor/autoload.php',     // Development (in framework repo)
  __DIR__ . '/../../../autoload.php',       // Installed as dependency (vendor/bin/)
];

$autoloader = null;
foreach ($autoloadPaths as $path) {
  if (file_exists($path)) {
    $autoloader = $path;
    break;
  }
}

if ($autoloader === null) {
  fwrite(STDERR, "Error: Could not find autoloader. Run 'composer install' first.\n");
  exit(1);
}

require $autoloader;

// Extensions are not in the root composer.json autoload (ADR-0004: no
// privileged built-in access), so register PSR-4 autoloading for them before
// any Pulsar\Extension\* class is referenced below (Studio console commands,
// StudioConfig, etc.). Scans the project's extensions/ and the framework's own.
\Pulsar\Extensibility\ExtensionAutoloader::registerForPaths(array_values(array_filter([
  getcwd() . '/extensions',
  __DIR__ . '/../extensions',
], 'is_dir')));

