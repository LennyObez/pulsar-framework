#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Pulsar Framework CLI
 *
 * This is the entry point for the Pulsar command-line interface.
 */

// Find autoloader (supports both development and installed scenarios)
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',     // Development (in framework repo)
    __DIR__ . '/../../../autoload.php',       // Installed as dependency
];

$autoloader = null;
foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        $autoloader = $path;
        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, "Error: Could not find autoloader. Run 'composer install' first.\n");
    exit(1);
}

require $autoloader;

use Pulsar\Config\ConfigManager;
use Pulsar\Config\DatabaseConfig;
use Pulsar\Console\Application;
use Pulsar\Console\Command\DiagnosticsCommand;
use Pulsar\Console\Command\InitCommand;
use Pulsar\Console\Command\ListCommand;
use Pulsar\Console\Command\MigrateCreateCommand;
use Pulsar\Console\Command\MigrateRollbackCommand;
use Pulsar\Console\Command\MigrateRunCommand;
use Pulsar\Console\Command\MigrateStatusCommand;
use Pulsar\Console\Command\ScaffoldExtensionCommand;
use Pulsar\Console\Command\ScaffoldModuleCommand;
use Pulsar\Console\Command\ShowContainerCommand;
use Pulsar\Console\Command\ShowRoutesCommand;
use Pulsar\Console\CommandInterface;
use Pulsar\Core\Kernel;
use Pulsar\Database\ConnectionManager;
use Pulsar\Database\Migration\MigrationRepository;
use Pulsar\Database\Migration\MigrationRunner;
use Pulsar\Extensibility\ExtensionBootstrap;

// Create kernel with optional extension support
$extensionBootstrap = null;

// Check for extensions directory
$extensionPaths = [
    getcwd() . '/extensions',
    __DIR__ . '/../extensions',
];

foreach ($extensionPaths as $path) {
    if (is_dir($path)) {
        $extensionBootstrap = ExtensionBootstrap::create();
        try {
            $extensionBootstrap->loadFromPaths([$path]);
        } catch (Throwable $e) {
            // Extension loading errors are non-fatal for CLI
            fwrite(STDERR, "Warning: Failed to load extensions: {$e->getMessage()}\n");
        }
        break;
    }
}

// Resolve config directory
$configPath = getcwd() . '/config';
if (!is_dir($configPath)) {
    $configPath = __DIR__ . '/../config';
}

$configManager = null;
if (is_dir($configPath)) {
    $configManager = new ConfigManager(configPath: $configPath);
}

$kernel = new Kernel(
    extensionBootstrap: $extensionBootstrap,
    configManager: $configManager,
);
try {
    $kernel->boot();
} catch (Throwable $e) {
    fwrite(STDERR, "Error: Kernel boot failed: {$e->getMessage()}\n");
    exit(1);
}

$application = new Application($kernel);

// Register built-in commands
$application->addCommands([
    new ListCommand($application),
    new ShowRoutesCommand($kernel),
    new ShowContainerCommand($kernel),
    new DiagnosticsCommand($kernel),
    new InitCommand(),
    new ScaffoldModuleCommand(),
    new ScaffoldExtensionCommand(),
]);

// Register migration commands (only if database is configured)
if ($kernel->container()->has(ConnectionManager::class)) {
    /** @var DatabaseConfig $dbConfig */
    $dbConfig = $kernel->container()->get(DatabaseConfig::class);

    /** @var ConnectionManager $connectionManager */
    $connectionManager = $kernel->container()->get(ConnectionManager::class);

    $migrationRepo = new MigrationRepository($dbConfig->migrationsPath);
    $migrationRunner = new MigrationRunner(
        $connectionManager->connection(),
        $migrationRepo,
        $dbConfig->migrationsTable,
    );

    $application->addCommands([
        new MigrateRunCommand($migrationRunner),
        new MigrateRollbackCommand($migrationRunner),
        new MigrateStatusCommand($migrationRunner, $migrationRepo),
        new MigrateCreateCommand($dbConfig->migrationsPath),
    ]);
}

// Register extension commands
if ($extensionBootstrap !== null) {
    foreach ($extensionBootstrap->getCommands() as $commandClass) {
        if (class_exists($commandClass)) {
            try {
                $command = $kernel->container()->has($commandClass)
                    ? $kernel->container()->get($commandClass)
                    : new $commandClass();

                if ($command instanceof CommandInterface) {
                    $application->add($command);
                }
            } catch (Throwable $e) {
                fwrite(STDERR, "Warning: Failed to register command $commandClass: {$e->getMessage()}\n");
            }
        }
    }
}

// Run the application
exit($application->run($argv));
