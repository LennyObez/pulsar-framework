// Resolve config directory: always prefer the project's config (via getcwd).
// Fall back to the framework's config only when running from within the
// framework repository itself (development mode). This prevents symlinked
// installs from accidentally using the framework's config/database/.env.
$projectRoot = getcwd() ?: __DIR__ . '/..';
$configPath = $projectRoot . '/config';
if (!is_dir($configPath)) {
  // Only fall back to framework config when getcwd IS the framework dir
  $frameworkConfig = __DIR__ . '/../config';
  if (is_dir($frameworkConfig) && realpath($projectRoot) === realpath(__DIR__ . '/..')) {
    $configPath = $frameworkConfig;
  }
  // Otherwise: no config dir found; ConfigManager will handle the error
}

// Anchor path helpers to the project root (parent of config/) when the operator
// has not set PULSAR_BASE_PATH. Without this, base_path()/var_path() fall back to
// getcwd(), so a `pulsar` command run from a subdirectory — or a built-in-server
// child this script proc_open's with a subdirectory docroot — would resolve
// var/cache and var/logs against the wrong root. putenv() mutates the process
// environment child processes inherit, so this fixes the served children too.
if (getenv('PULSAR_BASE_PATH') === false || getenv('PULSAR_BASE_PATH') === '') {
  putenv('PULSAR_BASE_PATH=' . dirname($configPath));
}

// Read extensions.enabled from app config (if present) to filter extension loading
$enabledExtensions = null;
$appConfigFile = $configPath . DIRECTORY_SEPARATOR . 'app.php';
if (is_file($appConfigFile)) {
  /** @var array<string, mixed>|mixed $appConfig */
  $appConfig = require $appConfigFile;
  if (is_array($appConfig)) {
    /** @var array<string, mixed>|mixed $extConfig */
    $extConfig = $appConfig['extensions'] ?? null;
    if (is_array($extConfig) && array_key_exists('enabled', $extConfig) && is_array($extConfig['enabled'])) {
      /** @var list<string> $enabledExtensions */
      $enabledExtensions = $extConfig['enabled'];
    }
  }
}

// Create kernel with optional extension support
$extensionBootstrap = null;

// Check for extensions directory
$extensionPaths = [
  getcwd() . '/extensions',
  __DIR__ . '/../extensions',
];

foreach ($extensionPaths as $path) {
  if (is_dir($path)) {
    $extensionBootstrap = ExtensionBootstrap::create();

    // Apply enabled filter before loading (if configured)
    if ($enabledExtensions !== null) {
      $extensionBootstrap->setEnabledFilter($enabledExtensions);
    }

    try {
      $extensionBootstrap->loadFromPaths([$path]);
    } catch (Throwable $e) {
      // Regulated deployments must fail-fast on extension load
      // errors — auth / audit / payment extensions failing silently
      // is a security incident. Pass `--continue-on-error`
      // explicitly to opt back into the warning-only behaviour
      // (developer convenience for an environment with one broken
      // extension among many).
      $continueOnError = in_array('--continue-on-error', $argv, true);

      fwrite(STDERR, "Error: Failed to load extensions: {$e->getMessage()}\n");

      if (!$continueOnError) {
        fwrite(STDERR, "Re-run with --continue-on-error to ignore extension load failures.\n");
        exit(1);
      }

      fwrite(STDERR, "Warning: continuing despite extension load failures (--continue-on-error).\n");
    }
    break;
  }
}

$configManager = null;
// basePath is ALWAYS the project root (never the framework directory)
$basePath = $projectRoot;
$envFile = $basePath . DIRECTORY_SEPARATOR . '.env';

if (is_dir($configPath)) {
  // Auto-generate .env with secure defaults if it does not exist.
  // This ensures pulsar serve and all CLI commands work out of the box
  // without manual configuration — the master key, APP_KEY, and SQLite
  // database are ready to use immediately.
  if (!is_file($envFile)) {
    $generatedKey = bin2hex(random_bytes(32));
    $generatedAppKey = 'base64:' . base64_encode(random_bytes(32));
    $appName = basename($basePath);

    $envContent = <<<ENV
    APP_NAME={$appName}
    APP_ENV=local
    APP_DEBUG=true
    APP_URL=http://localhost:8000

    APP_KEY={$generatedAppKey}
    PULSAR_MASTER_KEY={$generatedKey}

    DB_CONNECTION=sqlite
    DB_DATABASE=database/pulsar.sqlite
    ENV;

    // Dedent the heredoc content
    $envContent = implode("\n", array_map('ltrim', explode("\n", $envContent))) . "\n";

    file_put_contents($envFile, $envContent);
    fwrite(STDERR, "Generated .env with secure defaults (SQLite, auto-generated keys).\n");

    // Ensure the SQLite database directory exists
    $dbDir = $basePath . DIRECTORY_SEPARATOR . 'database';
    if (!is_dir($dbDir)) {
      mkdir($dbDir, 0755, true);
    }
  }

  $configManager = new ConfigManager(
    configPath: $configPath,
    envFilePath: $envFile,
  );
}

$kernel = new Kernel(
  extensionBootstrap: $extensionBootstrap,
  configManager: $configManager,
);

// Pre-boot FrameworkCache registration so the cache-aware boot path works.
// Resolve PULSAR_MASTER_KEY / CACHE_ENCRYPT through a .env-aware Environment
// (not raw getenv), so values provided only in .env are honoured here and by
// the doctor command below — getenv() never sees parsed .env values, which
// otherwise makes a .env-only master key look absent.
$cliEnvironment = Environment::load($envFile);
$masterKeyHex = $cliEnvironment->get('PULSAR_MASTER_KEY') ?? '';
if ($masterKeyHex !== '' && $configManager !== null) {
  try {
    $earlyMasterKey = MasterKey::fromHex($masterKeyHex);
    $cacheEncrypt = $cliEnvironment->get('CACHE_ENCRYPT');
    $encrypt = $cacheEncrypt === 'true' || $cacheEncrypt === '1';
    $earlyCache = new FrameworkCache($basePath, $earlyMasterKey, new HmacService(), $encrypt, environment: $cliEnvironment);
    $kernel->container()->instance(FrameworkCache::class, $earlyCache);
  } catch (Throwable) {
    // Invalid key or sodium failure — skip pre-boot cache
  }
}

try {
  $kernel->boot();
} catch (Throwable $e) {
  fwrite(STDERR, "Error: Kernel boot failed: {$e->getMessage()}\n");
  exit(1);
}

$application = new Application($kernel);

// Register built-in commands
$application->addCommands([
  new HelpCommand($application),
  new ListCommand($application),
  new ShowRoutesCommand($kernel),
  new ShowContainerCommand($kernel),
  new DiagnosticsCommand($kernel),
  new InitCommand(),
  new NewCommand(),
  new PreloadDumpCommand(),
  new MakeModuleCommand(),
  new MakeFeatureCommand(),
  new MakePortCommand(),
  new MakeAdapterCommand(),
  new MakeWebhookHandlerCommand(),
  new MakePaymentFlowCommand(),
  new MakeEventIngestionCommand(),
  new MakeExtensionCommand(),
  new MakeEventCommand(),
  new MakeListenerCommand(),
  new MakeTestCommand(),
  new RemoveModuleCommand(),
  new RemoveFeatureCommand(),
  new RemovePortCommand(),
  new RemoveAdapterCommand(),
  new RemoveWebhookHandlerCommand(),
  new RemovePaymentFlowCommand(),
  new RemoveEventIngestionCommand(),
  new RemoveExtensionCommand(),
]);

// Register kernel-dependent commands
$application->addCommands([
  new BuildCommand($kernel),
  new DebugContainerCommand($kernel),
  new StatusCommand($kernel),
]);

// Register no-constructor commands
$application->addCommands([
  new ExtensionValidateCommand(),
  new RuntimeReloadCommand(),
  new TestChangedCommand(null),
  new DocsCommand(),
]);

// Register serve command (always available)
$application->add(new ServeCommand($basePath));

// Register asset publish command (always available; resolves bundled framework assets)
$application->add(new AssetPublishCommand($basePath));

// Register the Docker development-environment commands (dev:start / dev:status /
// dev:stop). These scaffold and manage a Docker Compose dev stack and are
// distinct from `serve` (the built-in PHP server). The base DevConfig is read
// from config/dev.php when present; each command re-resolves it against CLI
// options at run time. (require returns 1 if the file was already loaded, so
// fall back to defaults unless it yields an array.)
$devConfigFile = $basePath . '/config/dev.php';
$devConfigData = file_exists($devConfigFile) && is_array($loaded = require $devConfigFile) ? $loaded : [];
$devConfig = DevConfig::fromArray($devConfigData);
$application->add(new DevStartCommand($devConfig, $basePath));
$application->add(new DevStatusCommand($devConfig));
$application->add(new DevStopCommand($devConfig));

// Register optimize + key commands (always visible)
$frameworkCache = $kernel->container()->has(FrameworkCache::class)
  ? $kernel->container()->get(FrameworkCache::class)
  : null;
/** @var FrameworkCache|null $frameworkCache */

$application->addCommands([
  new OptimizeCommand($kernel, $frameworkCache),
  new OptimizeClearCommand($frameworkCache),
  new OptimizeValidateCommand($kernel, $frameworkCache),
  new CacheWarmupCommand($kernel, $frameworkCache),
  new KeyGenerateCommand($basePath),
  new KeyRotateCommand($basePath),
]);

// Register metadata export command (if introspection is enabled)
if ($kernel->container()->has(ProjectMetadataService::class)) {
  /** @var ProjectMetadataService $metadataService */
  $metadataService = $kernel->container()->get(ProjectMetadataService::class);
  $scrubber = $kernel->container()->has(SensitiveDataScrubber::class)
    ? $kernel->container()->get(SensitiveDataScrubber::class)
    : new SensitiveDataScrubber();
  /** @var SensitiveDataScrubber $scrubber */
  $application->add(new MetadataExportCommand($metadataService, $scrubber));
  $application->add(new ConfigReferenceCommand($metadataService));
}

// Register doctor command (optional database dependency)
$doctorConnMgr = $kernel->container()->has(ConnectionManager::class)
  ? $kernel->container()->get(ConnectionManager::class)
  : null;
/** @var ConnectionManager|null $doctorConnMgr */
$application->add(new DoctorCommand($doctorConnMgr, $masterKeyHex ?: null, $basePath));

// Register debug commands (only if their dependencies are available)
if ($kernel->container()->has(ConfigRepository::class)) {
  /** @var ConfigRepository $configRepository */
  $configRepository = $kernel->container()->get(ConfigRepository::class);
  $application->add(new DebugConfigCommand($configRepository, []));
}

// Wiring-contract introspection: what each wiring provides/requires and what is degraded
$application->add(new DebugWiringCommand($kernel->container()));

if ($kernel->container()->has(RouterInterface::class)) {
  /** @var RouterInterface $router */
  $router = $kernel->container()->get(RouterInterface::class);
  $application->add(new DebugRoutesCommand($router));

  // Route cache command
  if ($kernel->container()->has(RouteCache::class)) {
    /** @var RouteCache $routeCache */
    $routeCache = $kernel->container()->get(RouteCache::class);
    $application->add(new RoutesCacheCommand($router, $routeCache, $basePath . '/storage/cache'));
  }
}

// Register extension list command (only if registry is available)
if ($kernel->container()->has(ExtensionRegistry::class)) {
  /** @var ExtensionRegistry $extensionRegistry */
  $extensionRegistry = $kernel->container()->get(ExtensionRegistry::class);
  $application->add(new ExtensionListCommand($extensionRegistry));
}

// Register health check and repair commands
if ($kernel->container()->has(HealthCheckRunnerInterface::class)) {
  /** @var HealthCheckRunnerInterface $healthRunner */
  $healthRunner = $kernel->container()->get(HealthCheckRunnerInterface::class);
  $application->add(new HealthCheckCommand($healthRunner));
}

if ($kernel->container()->has(RepairRunnerInterface::class)) {
  /** @var RepairRunnerInterface $repairRunner */
  $repairRunner = $kernel->container()->get(RepairRunnerInterface::class);
  $application->add(new RepairCommand($repairRunner));
}

// Register the security-posture preflight report command
if ($kernel->container()->has(SecurityPostureReport::class)) {
  /** @var SecurityPostureReport $posture */
  $posture = $kernel->container()->get(SecurityPostureReport::class);
  $application->add(new SecurityCheckCommand($posture));
}

// Register i18n commands
if ($kernel->container()->has(TranslationExtractor::class)) {
  /** @var TranslationExtractor $extractor */
  $extractor = $kernel->container()->get(TranslationExtractor::class);
  $application->add(new I18nExtractCommand($extractor, $basePath));
}

if ($kernel->container()->has(TranslationLinter::class)) {
  /** @var TranslationLinter $linter */
  $linter = $kernel->container()->get(TranslationLinter::class);
  $application->add(new I18nLintCommand($linter));
}

// Localized route-slug linter (completeness + collision checks)
if ($kernel->container()->has(SlugRegistry::class) && $kernel->container()->has(I18nConfig::class)) {
  /** @var SlugRegistry $slugRegistry */
  $slugRegistry = $kernel->container()->get(SlugRegistry::class);
  /** @var I18nConfig $i18nConfig */
  $i18nConfig = $kernel->container()->get(I18nConfig::class);
  $application->add(new SlugsLintCommand($slugRegistry, $i18nConfig));
}

// Register IDE helper command
if ($kernel->container()->has(ContainerInterface::class)) {
  $application->add(new IdeHelperCommand($kernel->container()));
}

// Register maintenance mode commands
if ($kernel->container()->has(MaintenanceMode::class)) {
  /** @var MaintenanceMode $maintenanceMode */
  $maintenanceMode = $kernel->container()->get(MaintenanceMode::class);
  $application->add(new MaintenanceEnableCommand($maintenanceMode));
  $application->add(new MaintenanceDisableCommand($maintenanceMode));
}

// Register the workflow timeout pump (ADR-0027: scheduled polling command)
if ($kernel->container()->has(WorkflowStorageInterface::class)) {
  /** @var WorkflowStorageInterface $workflowStorage */
  $workflowStorage = $kernel->container()->get(WorkflowStorageInterface::class);
  /** @var EventDispatcherInterface|null $workflowEvents */
  $workflowEvents = $kernel->container()->has(EventDispatcherInterface::class)
    ? $kernel->container()->get(EventDispatcherInterface::class)
    : null;
  $application->add(new WorkflowCheckTimeoutsCommand($workflowStorage, $workflowEvents));
}

// Register runtime commands
if ($kernel->container()->has(RuntimeResolver::class)) {
  /** @var RuntimeResolver $runtimeResolver */
  $runtimeResolver = $kernel->container()->get(RuntimeResolver::class);
  $application->add(new RuntimeStatusCommand($runtimeResolver));

  if ($kernel->container()->has(RuntimeFactory::class)) {
    /** @var RuntimeFactory $runtimeFactory */
    $runtimeFactory = $kernel->container()->get(RuntimeFactory::class);
    $runtimeConfig = $kernel->container()->has(RuntimeConfig::class)
      ? $kernel->container()->get(RuntimeConfig::class)
      : null;
    /** @var RuntimeConfig|null $runtimeConfig */
    $application->add(new RuntimeServeCommand($kernel, $runtimeFactory, $runtimeResolver, $runtimeConfig));
  }
}

// Register scheduler commands
if ($kernel->container()->has(Scheduler::class)) {
  /** @var Scheduler $scheduler */
  $scheduler = $kernel->container()->get(Scheduler::class);
  $application->add(new ScheduleRunCommand($scheduler));
  $application->add(new SchedulerTickCommand($scheduler));
}

if ($kernel->container()->has(JobRegistry::class)) {
  /** @var JobRegistry $jobRegistry */
  $jobRegistry = $kernel->container()->get(JobRegistry::class);
  $application->add(new SchedulerListCommand($jobRegistry));
}

// Register secret vault commands
if ($kernel->container()->has(SecretVault::class)) {
  /** @var SecretVault $vault */
  $vault = $kernel->container()->get(SecretVault::class);
  $application->add(new SecretGetCommand($vault));
  $application->add(new SecretListCommand($vault));
  $application->add(new SecretSetCommand($vault));
}

// Register self-update command
if ($kernel->container()->has(ReleaseCheckerInterface::class)) {
  /** @var ReleaseCheckerInterface $releaseChecker */
  $releaseChecker = $kernel->container()->get(ReleaseCheckerInterface::class);
  $application->add(new SelfUpdateCommand($releaseChecker));
}

// Register queue commands (only if queue is configured)
if ($kernel->container()->has(QueueConfig::class)) {
  if ($kernel->container()->has(QueueDriverInterface::class)) {
    /** @var QueueDriverInterface $queueDriver */
    $queueDriver = $kernel->container()->get(QueueDriverInterface::class);
    $application->add(new QueueWorkCommand($queueDriver));
    $application->add(new QueueFlushCommand($queueDriver));
  }

  if ($kernel->container()->has(QueueManager::class) && $kernel->container()->has(DeadLetterQueue::class)) {
    /** @var QueueManager $queueManager */
    $queueManager = $kernel->container()->get(QueueManager::class);
    /** @var DeadLetterQueue $deadLetterQueue */
    $deadLetterQueue = $kernel->container()->get(DeadLetterQueue::class);
    $application->add(new QueueStatusCommand($queueManager, $deadLetterQueue));
    $application->add(new QueueRetryCommand($deadLetterQueue));
    $application->add(new QueueFailedCommand($deadLetterQueue));
  }
}

// Register supervisor commands (only if supervisor is configured)
if ($kernel->container()->has(SupervisorConfig::class)) {
  /** @var SupervisorConfig $supervisorConfig */
  $supervisorConfig = $kernel->container()->get(SupervisorConfig::class);
  $application->add(new SupervisorStatusCommand($supervisorConfig));
  if ($kernel->container()->has(PreflightRunnerInterface::class)) {
    /** @var PreflightRunnerInterface $preflightRunner */
    $preflightRunner = $kernel->container()->get(PreflightRunnerInterface::class);
    $application->add(new SupervisorCheckCommand($preflightRunner));
  }
}

// Register integrity commands (only if integrity is configured and enabled)
if ($kernel->container()->has(ManifestBuilderInterface::class)) {
  /** @var IntegrityConfig $integrityConfig */
  $integrityConfig = $kernel->container()->get(IntegrityConfig::class);

  /** @var ManifestBuilderInterface $manifestBuilder */
  $manifestBuilder = $kernel->container()->get(ManifestBuilderInterface::class);

  /** @var ManifestVerifierInterface $manifestVerifier */
  $manifestVerifier = $kernel->container()->get(ManifestVerifierInterface::class);

  /** @var ManifestSignerInterface|null $manifestSigner */
  $manifestSigner = $kernel->container()->has(ManifestSignerInterface::class)
    ? $kernel->container()->get(ManifestSignerInterface::class)
    : null;

  $application->addCommands([
    new IntegrityBuildCommand($integrityConfig, $manifestBuilder, $basePath, $manifestSigner),
    new IntegrityVerifyCommand($integrityConfig, $manifestVerifier, $basePath),
  ]);

  if ($kernel->container()->has(AuditLogger::class)) {
    /** @var AuditLogger $auditLogger */
    $auditLogger = $kernel->container()->get(AuditLogger::class);
    $application->add(new IntegrityRepairCommand($integrityConfig, $manifestBuilder, $auditLogger, $basePath));
  }
}

// Register deploy check command (only if deploy is configured)
if ($kernel->container()->has(DeployCheck::class)) {
  /** @var DeployCheck $deployCheck */
  $deployCheck = $kernel->container()->get(DeployCheck::class);
  $application->add(new DeployCheckCommand($deployCheck));
}

// Register the database failover watcher (only when failover is enabled + wired)
if ($kernel->container()->has(DbFailoverWatchCommand::class)) {
  /** @var DbFailoverWatchCommand $failoverWatch */
  $failoverWatch = $kernel->container()->get(DbFailoverWatchCommand::class);
  $application->add($failoverWatch);
}

// Register migration commands (only if database is configured)
if ($kernel->container()->has(ConnectionManager::class)) {
  /** @var DatabaseConfig $dbConfig */
  $dbConfig = $kernel->container()->get(DatabaseConfig::class);

  /** @var ConnectionManager $connectionManager */
  $connectionManager = $kernel->container()->get(ConnectionManager::class);

  // Resolve migration paths from project config + extensions
  $extRegistry = $kernel->container()->has(ExtensionRegistry::class)
    ? $kernel->container()->get(ExtensionRegistry::class)
    : null;
  $pathResolver = new MigrationPathResolver($dbConfig, $extRegistry);
  $kernel->container()->instance(MigrationPathResolverInterface::class, $pathResolver);

  $migrationRepo = new MigrationRepository($pathResolver->resolve());
  $migrationRunner = new MigrationRunner(
    $connectionManager->connection(),
    $migrationRepo,
    $dbConfig->migrationsTable,
  );

  $application->addCommands([
    new MigrateRunCommand($migrationRunner),
    new MigrateRollbackCommand($migrationRunner),
    new MigrateStatusCommand($migrationRunner, $migrationRepo),
    new MigrateCreateCommand($dbConfig->migrationsPath),
  ]);

  // Register db: commands (same database dependency guard)
  if ($kernel->container()->has(DatabaseIntrospectorInterface::class)) {
    /** @var DatabaseIntrospectorInterface $introspector */
    $introspector = $kernel->container()->get(DatabaseIntrospectorInterface::class);
    $application->add(new DbInspectCommand($introspector));
    $application->add(new DbFreshCommand(
      $connectionManager->connection(),
      $introspector,
      $migrationRunner,
      $kernel->container()->has(SeederRunner::class)
        ? $kernel->container()->get(SeederRunner::class)
        : null,
    ));
  }

  if ($kernel->container()->has(SeederRunner::class)) {
    /** @var SeederRunner $seederRunner */
    $seederRunner = $kernel->container()->get(SeederRunner::class);
    $application->add(new DbSeedCommand($seederRunner));
  }
}

// Register Studio commands (only if Studio is configured)
if ($kernel->container()->has(StudioConfig::class)) {
  /** @var StudioConfig $studioConfig */
  $studioConfig = $kernel->container()->get(StudioConfig::class);

  // Umbrella commands (always available when config exists)
  $studioStore = $kernel->container()->has(EventStoreInterface::class)
    ? $kernel->container()->get(EventStoreInterface::class)
    : null;
  /** @var EventStoreInterface|null $studioStore */

  $application->addCommands([
    new StudioStatusCommand($studioConfig, $studioStore),
    new StudioServeCommand($studioConfig, $basePath),
    new StudioOpenCommand($studioConfig),
    new StudioDoctorCommand($studioConfig, $basePath),
    new StudioEnableCommand($basePath),
    new StudioDisableCommand($basePath),
  ]);

  // Console sub-commands (only when Studio manager is active)
  if ($kernel->container()->has(StudioManager::class) && $studioStore !== null) {
    $application->addCommands([
      new ConsoleStatusCommand($studioStore),
      new ConsoleTailCommand($studioStore),
      new ConsoleQueryCommand($studioStore),
    ]);

    // Observability commands
    if ($kernel->container()->has(DashboardAggregator::class)) {
      /** @var DashboardAggregator $aggregator */
      $aggregator = $kernel->container()->get(DashboardAggregator::class);

      $application->addCommands([
        new ConsoleMetricsCommand($aggregator),
        new ConsoleRoutesCommand($aggregator),
        new ConsoleExceptionsCommand($aggregator),
      ]);
    }

    if ($kernel->container()->has(TimelineBuilder::class)) {
      /** @var TimelineBuilder $timelineBuilder */
      $timelineBuilder = $kernel->container()->get(TimelineBuilder::class);
      $application->add(new ConsoleTimelineCommand($studioStore, $timelineBuilder));
    }

    $application->add(new ConsoleJobsCommand($studioStore));

    // Evidence commands
    if ($kernel->container()->has(EvidenceExporter::class)) {
      /** @var EvidenceExporter $exporter */
      $exporter = $kernel->container()->get(EvidenceExporter::class);
      $application->add(new EvidenceExportCommand($exporter));
    }

    if ($kernel->container()->has(EvidenceVerifier::class)) {
      /** @var EvidenceVerifier $verifier */
      $verifier = $kernel->container()->get(EvidenceVerifier::class);
      $application->add(new EvidenceVerifyCommand($verifier));
    }

    $application->add(new EvidenceStatusCommand($studioStore));
    $application->add(new EvidencePurgeCommand($studioStore));

    if ($kernel->container()->has(RetentionEnforcer::class)) {
      /** @var RetentionEnforcer $retentionEnforcer */
      $retentionEnforcer = $kernel->container()->get(RetentionEnforcer::class);
      $application->add(new RetentionApplyCommand($retentionEnforcer));
    }

    if ($kernel->container()->has(RedactionPipeline::class)) {
      /** @var RedactionPipeline $redactionPipeline */
      $redactionPipeline = $kernel->container()->get(RedactionPipeline::class);
      $application->add(new RedactionTestCommand($redactionPipeline));
    }

    // Guardian commands
    $application->add(new GuardianStatusCommand($studioStore));

    if ($kernel->container()->has(Supervisor::class)) {
      /** @var Supervisor $supervisor */
      $supervisor = $kernel->container()->get(Supervisor::class);
      $application->add(new GuardianCheckCommand($supervisor));
      $application->add(new GuardianSupervisorRunOnceCommand($supervisor));
    }

    if ($kernel->container()->has(SupervisorConfig::class)) {
      /** @var SupervisorConfig $supervisorConfig */
      $supervisorConfig = $kernel->container()->get(SupervisorConfig::class);
      $application->add(new GuardianSupervisorStatusCommand($supervisorConfig));
    }

    if ($kernel->container()->has(DeployCheck::class)) {
      /** @var DeployCheck $deployCheck */
      $deployCheck = $kernel->container()->get(DeployCheck::class);
      $application->add(new GuardianDeployCheckCommand($deployCheck));
    }

    if ($kernel->container()->has(IntegrityConfig::class)) {
      /** @var IntegrityConfig $integrityConfig */
      $integrityConfig = $kernel->container()->get(IntegrityConfig::class);
      $manifestBuilder = new ManifestBuilder($basePath);
      $manifestVerifier = new ManifestVerifier($basePath);

      try {
        $manifestSigner = $kernel->container()->has(MasterKey::class)
          ? new ManifestSigner(
            $kernel->container()->has(HmacInterface::class)
              ? $kernel->container()->get(HmacInterface::class)
              : new HmacService(),
            $kernel->container()->get(MasterKey::class),
          )
          : null;
      } catch (Throwable $e) {
        fwrite(STDERR, "Warning: Failed to initialize manifest signer: {$e->getMessage()}\n");
        $manifestSigner = null;
      }

      $application->add(new GuardianIntegrityBuildCommand($manifestBuilder, $integrityConfig, $manifestSigner));
      $application->add(new GuardianIntegrityVerifyCommand($manifestVerifier, $integrityConfig, $manifestSigner));
    }

    // Benchmark command
    if ($kernel->container()->has(StudioManager::class)) {
      /** @var StudioManager $studioManager */
      $studioManager = $kernel->container()->get(StudioManager::class);
      $application->add(
        new ConsoleBenchmarkCommand(
          $studioManager->emitCallback(),
          $basePath,
        )
      );
    }
  }
}

// Register View commands
if ($kernel->container()->has(ViewCompileCommand::class)) {
  /** @var ViewCompileCommand $viewCompileCmd */
  $viewCompileCmd = $kernel->container()->get(ViewCompileCommand::class);
  $application->add($viewCompileCmd);
}

$application->add(new PlaygroundServeCommand($basePath));

// Register REPL shell command
{
  $replConfigFile = $configPath . '/repl.php';

  /** @var array<string, mixed> $replData */
  $replData = is_file($replConfigFile) ? (require $replConfigFile) : [];

  $replEnvironment = $configManager?->environment() ?? Environment::load();
  $replMode = $replEnvironment->resolveMode();
  $replConfig = is_array($replData) ? ReplConfig::fromArray($replData, $replEnvironment) : new ReplConfig();
  $replGuard = new EnvironmentGuard($replMode, $replEnvironment, $replConfig->enabled);

  $replAuditLogger = null;
  if ($replConfig->audit && $kernel->container()->has(AuditLoggerInterface::class)) {
    /** @var AuditLoggerInterface $auditLoggerInstance */
    $auditLoggerInstance = $kernel->container()->get(AuditLoggerInterface::class);
    $replAuditLogger = new ReplAuditLogger($auditLoggerInstance, bin2hex(random_bytes(16)));
  }

  $replRedactor = null;
  if ($kernel->container()->has(SensitiveDataScrubber::class)) {
    /** @var SensitiveDataScrubber $replScrubber */
    $replScrubber = $kernel->container()->get(SensitiveDataScrubber::class);
    $replRedactor = new SecretRedactor($replScrubber);
  }

  $application->add(
    new ShellCommand(
      $kernel->container(),
      $replMode,
      $replGuard,
      $replConfig,
      $replAuditLogger,
      $replRedactor,
    )
  );
}

// Register import/export commands (only if registry is available)
if ($kernel->container()->has(\Pulsar\ImportExport\ImportExportRegistry::class)) {
  /** @var \Pulsar\ImportExport\ImportExportRegistry $importExportRegistry */
  $importExportRegistry = $kernel->container()->get(\Pulsar\ImportExport\ImportExportRegistry::class);
  $application->addCommands([
    new \Pulsar\ImportExport\Command\ExportCommand($importExportRegistry),
    new \Pulsar\ImportExport\Command\ImportCommand($importExportRegistry),
  ]);
}

// Register supply-chain commands (always available; they validate prerequisites at runtime).
// config/supply-chain.php is read once into SupplyChainConfig; each command receives its
// typed section (license allowlist, required pipeline tools, VEX paths, signing paths) so an
// operator's policy actually applies instead of the commands running on hard-coded defaults.
// CLI options still override the config-provided defaults per invocation.
if (class_exists(\Pulsar\SupplyChain\Command\VexCommand::class)) {
  $supplyChainFile = $basePath . '/config/supply-chain.php';
  $supplyChainData = file_exists($supplyChainFile) && is_array($loaded = require $supplyChainFile) ? $loaded : [];
  $supplyChainConfig = SupplyChainConfig::fromArray($supplyChainData);

  $application->addCommands([
    new \Pulsar\SupplyChain\Command\VexCommand($basePath, $supplyChainConfig->vex),
    new \Pulsar\SupplyChain\Command\AuditPipelineCommand($basePath, $supplyChainConfig->pipeline),
    new \Pulsar\SupplyChain\Command\LicenseCheckCommand($basePath, $supplyChainConfig->licenses),
    new \Pulsar\SupplyChain\Command\SignCommand($basePath, $supplyChainConfig->signing),
    new \Pulsar\SupplyChain\Command\VerifyCommand($basePath, $supplyChainConfig->signing),
  ]);
}

// Register extension commands
if ($extensionBootstrap !== null) {
  foreach ($extensionBootstrap->getCommands() as $commandClass) {
    if (!class_exists($commandClass)) {
      continue;
    }

    try {
      if ($kernel->container()->has($commandClass)) {
        $command = $kernel->container()->get($commandClass);
      } else {
        $ref = new ReflectionClass($commandClass);
        $ctor = $ref->getConstructor();

        // Only attempt direct instantiation for commands with no required constructor params
        if ($ctor !== null && $ctor->getNumberOfRequiredParameters() > 0) {
          continue;
        }

        $command = $ref->newInstance();
      }

      if ($command instanceof CommandInterface) {
        $application->add($command);
      }
    } catch (Throwable $e) {
      // Command registration failures are fail-fast by default (a
      // missing command typically means a misconfigured extension
      // that pulled the rest of the dependency graph along with it).
      // `--continue-on-error` opts into warning-only behaviour.
      $continueOnError = in_array('--continue-on-error', $argv, true);

      fwrite(STDERR, "Error: Failed to register command $commandClass: {$e->getMessage()}\n");

      if (!$continueOnError) {
        fwrite(STDERR, "Re-run with --continue-on-error to ignore command registration failures.\n");
        exit(1);
      }
    }
  }
}

// Run the application
exit($application->run($argv));
