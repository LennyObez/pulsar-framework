{
  "name": "pulsar/framework",
  "description": "Pulsar HMVC Framework (PHP 8.5)",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "ext-ctype": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "php": "^8.5",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.0",
    "roave/security-advisories": "dev-latest",
    "vimeo/psalm": "^6.15"
  },
  "autoload": {
    "psr-4": {
      "Pulsar\\": "src/",
      "Pulsar\\Extension\\Example\\": "extensions/example/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pulsar\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/pulsar"
  ],
  "scripts": {
    "test": "phpunit -c tools/php/phpunit.xml",
    "test:coverage": "phpunit -c tools/php/phpunit.xml --coverage-clover coverage/clover.xml --coverage-html coverage/html",
    "phpstan": "php -d memory_limit=512M vendor/bin/phpstan analyse -c tools/php/phpstan.neon",
    "psalm": "psalm -c tools/php/psalm.xml",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "qa": [
      "@cs:check",
      "@phpstan",
      "@psalm",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
