{
  "name": "pulsar/framework",
  "version": "1.0.0-rc.7",
  "description": "Pulsar HMVC Framework (PHP 8.5)",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-sodium": "*",
    "php": "^8.5",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.6",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpbench/phpbench": "^1.3",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.0",
    "roave/security-advisories": "dev-latest",
    "vimeo/psalm": "^6.15"
  },
  "suggest": {
    "ext-pcntl": "Required for queue worker signal handling (Unix only)",
    "ext-sockets": "Required for persistent HTTP runtime (optional, guarded by runtime check)"
  },
  "autoload": {
    "psr-4": {
      "Pulsar\\": "src/",
      "Pulsar\\Extension\\Example\\": "extensions/example/src/",
      "Pulsar\\Extension\\Payments\\": "extensions/payments/src/",
      "Pulsar\\Extension\\Studio\\": "extensions/studio/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pulsar\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/pulsar"
  ],
  "scripts": {
    "test": "phpunit -c tools/php/phpunit.xml",
    "test:coverage": "phpunit -c tools/php/phpunit.xml --coverage-clover coverage/clover.xml --coverage-html coverage/html",
    "phpstan": "php -d memory_limit=512M vendor/bin/phpstan analyse -c tools/php/phpstan.neon",
    "psalm": "psalm -c tools/php/psalm.xml",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "api:snapshot": "php tools/api/generate-snapshot.php",
    "bench": "phpbench run --config=tools/php/phpbench.json --report=default",
    "bench:ci": "phpbench run --config=tools/php/phpbench.json --report=default --progress=none",
    "bench:profiles": "php tools/bench/run.php",
    "bench:profiles:ci": "php tools/bench/run.php --output=var/bench/results.json",
    "deptrac": "deptrac analyse --config-file=tools/php/deptrac.yaml",
    "boundary:deptrac": "@deptrac",
    "boundary:custom": "php scripts/boundary_check.php",
    "boundary:check": [
      "@boundary:deptrac",
      "@boundary:custom"
    ],
    "qa": [
      "@cs:check",
      "@phpstan",
      "@psalm",
      "@boundary:check",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
