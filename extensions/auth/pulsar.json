{
  "name": "pulsar/auth",
  "version": "1.0.0-rc.11",
  "description": "Unified authentication extension: social SSO, OAuth2 server, WebAuthn/FIDO2, and TOTP 2FA",
  "trust_tier": "core",
  "extension_class": "Pulsar\\Extension\\Auth\\AuthExtension",
  "pulsar": {
    "min_version": "1.0.0-rc.11"
  },
  "replaces": ["pulsar/social-sso", "pulsar/oauth2", "pulsar/webauthn"],
  "provides": {
    "services": [
      "SsoGatewayInterface",
      "OAuthProviderInterface",
      "OAuthProviderRegistryInterface",
      "OAuthStateManagerInterface",
      "NonceVerifierInterface",
      "IdTokenVerifierInterface",
      "SocialIdentityLinkerInterface",
      "AuthorizationServerInterface",
      "TokenIssuerInterface",
      "ClientRepositoryInterface",
      "ScopeRepositoryInterface",
      "ConsentRepositoryInterface",
      "AuthorizationCodeRepositoryInterface",
      "RefreshTokenRepositoryInterface",
      "AccessTokenRepositoryInterface",
      "UserClaimsProviderInterface",
      "WebAuthnServerInterface",
      "CredentialRepositoryInterface",
      "AttestationVerifierInterface",
      "AuthenticatorRepositoryInterface"
    ],
    "routes": true,
    "commands": []
  }
}
