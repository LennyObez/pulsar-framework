{
  "name": "pulsar/cms",
  "version": "1.0.0-rc.12",
  "description": "First-class CMS extension for regulated domains: content management, taxonomy, navigation, editorial workflow, custom fields, and full-page caching",
  "trust_tier": "core",
  "kind": "product",
  "extension_class": "Pulsar\\Extension\\Cms\\CmsExtension",
  "pulsar": {
    "min_version": "1.0.0-rc.12"
  },
  "requires": {},
  "suggests": {
    "pulsar/studio": ">=1.0.0-rc.12",
    "pulsar/admin": ">=1.0.0-rc.12",
    "pulsar/orm": ">=1.0.0-rc.12",
    "pulsar/payments": ">=1.0.0-rc.12"
  },
  "provides": {
    "services": [
      "ContentServiceInterface",
      "TaxonomyServiceInterface",
      "MenuRepositoryInterface",
      "SettingsServiceInterface",
      "ContentTypeRegistryInterface",
      "EditorialWorkflowServiceInterface",
      "ContentLockServiceInterface",
      "SafeHtmlPolicy",
      "BreadcrumbGeneratorInterface",
      "AccountSectionRegistry"
    ],
    "routes": true,
    "migrations": ["src/Migration"],
    "commands": [
      "Pulsar\\Extension\\Cms\\Command\\CmsServeCommand",
      "Pulsar\\Extension\\Cms\\Command\\CmsPublishScheduledCommand",
      "Pulsar\\Extension\\Cms\\Command\\CmsImportCommand",
      "Pulsar\\Extension\\Cms\\Command\\ThemeActivateCommand",
      "Pulsar\\Extension\\Cms\\Command\\ThemeInstallCommand"
    ]
  }
}
