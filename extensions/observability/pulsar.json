{
  "name": "pulsar/observability",
  "version": "1.0.0-rc.11",
  "description": "Unified observability: tracing, metrics, log export via OTLP and JSON Lines",
  "trust_tier": "core",
  "extension_class": "Pulsar\\Extension\\Observability\\ObservabilityExtension",
  "pulsar": {
    "min_version": "1.0.0-rc.11"
  },
  "provides": {
    "services": [
      "OtlpTracerBridge",
      "OtlpMeterBridge",
      "OtlpLogBridge",
      "SpanExporter",
      "MetricsExporter",
      "ErrorExporter"
    ],
    "routes": false,
    "commands": []
  },
  "replaces": ["pulsar/opentelemetry", "pulsar/observability-export"]
}
