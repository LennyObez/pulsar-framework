{
  "name": "pulsar/payments",
  "version": "1.0.0-rc.11",
  "description": "Unified payment processing with one-time payments, recurring subscriptions, invoicing, multi-gateway support (Stripe, PayPal, SEPA, Payconiq, Bancontact, iDEAL, Klarna), QR code payments (EPC QR, Payconiq), and mobile in-app purchase verification (App Store, Google Play)",
  "trust_tier": "core",
  "kind": "product",
  "extension_class": "Pulsar\\Extension\\Payments\\PaymentsExtension",
  "pulsar": {
    "min_version": "1.0.0-rc.11"
  },
  "provides": {
    "services": [
      "PaymentGateway",
      "QrPaymentGateway",
      "WebhookProcessor",
      "SubscriptionManager",
      "InvoiceRenderer",
      "MobileVerifier",
      "PaymentProviderInterface",
      "SubscriptionManagerInterface",
      "InvoiceRendererInterface",
      "RefundProcessorInterface",
      "MobileVerifierInterface",
      "IdempotencyStoreInterface",
      "WebhookEventLogInterface",
      "WebhookVerifierInterface",
      "PayconiqGateway",
      "BancontactGateway",
      "IdealGateway",
      "KlarnaGateway"
    ],
    "routes": true,
    "commands": [],
    "blocks": [
      "DonateButtonBlock",
      "PricingTableBlock",
      "CheckoutFormBlock",
      "ProductCardBlock",
      "QrPaymentBlock"
    ]
  },
  "replaces": ["pulsar/subscriptions"]
}
