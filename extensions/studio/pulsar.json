{
  "name": "pulsar/studio",
  "version": "1.0.0-rc.11",
  "description": "Development console with event collection, evidence chain, and diagnostics UI",
  "trust_tier": "core",
  "extension_class": "Pulsar\\Extension\\Studio\\StudioExtension",
  "pulsar": {
    "min_version": "1.0.0-rc.11"
  },
  "provides": {
    "services": ["StudioManager", "EventStoreInterface", "DashboardAggregator"],
    "routes": true,
    "migrations": ["database/migrations"],
    "commands": [
      "Pulsar\\Extension\\Studio\\Command\\Console\\ConsoleExportCommand",
      "Pulsar\\Extension\\Studio\\Command\\Console\\ConsoleVerifyCommand",
      "Pulsar\\Extension\\Studio\\Command\\Console\\Guardian\\GuardianCheckCommand",
      "Pulsar\\Extension\\Studio\\Command\\Console\\Guardian\\GuardianSupervisorRunOnceCommand"
    ]
  },
  "frontend": {
    "bundles": [
      {
        "id": "studio",
        "root": "frontend",
        "entries": ["src/main.ts"]
      }
    ]
  }
}
