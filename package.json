{
  "name": "@pulsar/tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "lint": "eslint . --ignore-pattern '*.config.*' --no-error-on-unmatched-pattern",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build:studio": "tsc -p resources/studio/tsconfig.json"
  }
}
