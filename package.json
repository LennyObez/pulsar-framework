{
  "name": "@pulsar/tooling",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ajv": ">=6.14.0 <7.0.0",
      "brace-expansion": ">=5.0.8",
      "esbuild": ">=0.28.1",
      "flatted": ">=3.4.2",
      "js-yaml": ">=4.2.0",
      "minimatch": ">=9.0.6",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18",
      "rollup": ">=4.59.0",
      "undici": ">=7.24.0 <8",
      "vite": ">=8.0.16"
    }
  },
  "scripts": {
    "lint": "eslint . --ignore-pattern '*.config.*' --no-error-on-unmatched-pattern --quiet",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extensions/analytics/frontend/tsconfig.json && tsc --noEmit -p extensions/analytics/frontend/tracker/tsconfig.json && tsc --noEmit -p extensions/cms/frontend/tsconfig.json && tsc --noEmit -p extensions/admin/frontend/tsconfig.json && tsc --noEmit -p extensions/studio/frontend/tsconfig.json",
    "build:studio": "tsc -p extensions/studio/frontend/tsconfig.json",
    "build:admin": "tsc -p extensions/admin/frontend/tsconfig.json",
    "build:cms": "node extensions/cms/frontend/build.mjs --prod",
    "build:cms:dev": "node extensions/cms/frontend/build.mjs",
    "build:cms:watch": "node extensions/cms/frontend/build.mjs --watch",
    "build": "pnpm build:studio && pnpm build:admin && pnpm build:cms"
  }
}
