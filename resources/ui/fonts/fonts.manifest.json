{
  "documentation": [
    "What is bundled in resources/ui/fonts/, where each file came from, and what it is required to cover.",
    "Written by scripts/build-fonts.sh. Two gates read it, and neither can bless a broken face alone:",
    "tools/ci/verify-bundled-fonts.mjs parses the WOFF2 bytes and proves the coverage, axes, features and unicode-ranges claimed here are real (pnpm test);",
    "tests/Unit/Integrity/BundledFontAssetGateTest.php proves the bytes on disk are the bytes verified here, and that tokens.css agrees (composer test).",
    "A latin-ext subset slice of JetBrains Mono once shipped as the whole code face: 190 codepoints, no digits, no a-z, no punctuation. Nothing was checking, so nothing failed.",
    "The repair for that shipped every face whole and cost every reader 45% more bytes. Each face is now split by script, and a browser fetches only the subsets a page's text needs."
  ],
  "faceRoles": {
    "mono": "must render source code: digits, a-z, A-Z and every ASCII punctuation mark, plus the Latin-1 letters user data carries",
    "heading": "must render the Latin text the framework ships in resources/lang/",
    "body": "must render the Latin text the framework ships in resources/lang/"
  },
  "fontDirectory": "resources/ui/fonts",
  "styleSheet": "resources/ui/css/tokens.css",
  "styleSheetRegion": {
    "begin": "/* pulsar:font-face:begin",
    "end": "/* pulsar:font-face:end */",
    "note": "Everything between these markers is written by scripts/build-fonts.sh. Editing it by hand makes the style sheet disagree with the files it names, which the gates refuse."
  },
  "localeSources": ["resources/lang", "extensions/*/resources/lang"],
  "styleSheetSources": ["resources/ui/css", "extensions/*/resources/css"],
  "subsetPolicy": [
    {
      "name": "latin",
      "why": "ASCII, Latin-1 and the punctuation, currency and typographic marks a Western European page is set in. This is the only subset a Latin-only reader downloads.",
      "ranges": [
        "U+0000-00FF",
        "U+0131-0131",
        "U+0152-0153",
        "U+02BB-02BC",
        "U+02C6-02C6",
        "U+02DA-02DA",
        "U+02DC-02DC",
        "U+2000-206F",
        "U+2074-2074",
        "U+20AC-20AC",
        "U+2122-2122",
        "U+2191-2191",
        "U+2193-2193",
        "U+2212-2212",
        "U+2215-2215",
        "U+FEFF-FEFF",
        "U+FFFD-FFFD"
      ]
    },
    {
      "name": "greek",
      "why": "the Greek and Coptic block, which the el locale is written in.",
      "ranges": ["U+0370-03FF"]
    },
    {
      "name": "greek-ext",
      "why": "polytonic Greek, for classical and liturgical text.",
      "ranges": ["U+1F00-1FFF"]
    },
    {
      "name": "cyrillic",
      "why": "the Cyrillic the bg locale is written in, plus the numero sign that goes with it.",
      "ranges": ["U+0400-045F", "U+0490-0491", "U+04B0-04B1", "U+2116-2116"]
    },
    {
      "name": "cyrillic-ext",
      "why": "the Cyrillic beyond the Russian and Bulgarian alphabets, plus historic forms.",
      "ranges": [
        "U+0460-052F",
        "U+1C80-1C8F",
        "U+20B4-20B4",
        "U+2DE0-2DFF",
        "U+A640-A69F",
        "U+FE2E-FE2F"
      ]
    },
    {
      "name": "vietnamese",
      "why": "the precomposed Vietnamese block; no shipped locale needs it, and the glyphs exist upstream, so they are carried where nobody pays for them unread.",
      "ranges": ["U+1EA0-1EFF"]
    },
    {
      "name": "latin-ext",
      "why": "Latin Extended-A through D and the combining marks: the cs, pl, hu, lt, lv, mt, ro, sk, sl, hr and et locales are written in this.",
      "ranges": [
        "U+0100-02FF",
        "U+0300-036F",
        "U+1AB0-1AFF",
        "U+1DC0-1DFF",
        "U+1E00-1E9F",
        "U+2070-209F",
        "U+20A0-20CF",
        "U+2100-214F",
        "U+2C60-2C7F",
        "U+A720-A7FF",
        "U+AB30-AB6F",
        "U+FB00-FB4F"
      ]
    },
    {
      "name": "symbols",
      "why": "everything else the upstream font carries — arrows, box drawing, mathematical operators — claimed by no earlier subset. It exists so the split cannot lose a codepoint the table did not anticipate.",
      "ranges": []
    }
  ],
  "firstPaint": {
    "subset": "latin",
    "ceilingBytes": 535208,
    "ceilingSource": "the total size of the five whole-family faces the framework bundled before they were split, measured with `git cat-file -s` at the commit this build script was written. The split may not cost a Latin reader more than the bundle it replaced."
  },
