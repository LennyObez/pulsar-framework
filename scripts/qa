#!/usr/bin/env bash
#
# Pulsar Quality Gate
#
# The PHP half of this script used to be its own list -- CS-Fixer, PHPStan, Psalm,
# PHPUnit -- which is to say a THIRD definition of "the gate", alongside
# composer.json's `qa` script and .github/workflows/ci.yml. Three lists, no
# coupling. This one silently omitted boundary enforcement, the class-shape
# ratchet, malicious-code analysis, the version check, PSR-4 conformance, Semgrep
# and the compliance report, while CONTRIBUTING.md pointed contributors at it as
# "the same gate as CI".
#
# It now delegates. `composer qa` is the single definition of the PHP gate,
# tools/ci/assert-qa-ci-parity.php asserts that CI runs every entry of it, and this
# file adds only the JS/TS half, which lives in package.json rather than
# composer.json and therefore cannot be a `qa` entry.
#
# Exit codes:
#   0 - All checks passed
#   1 - One or more checks failed
#

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT" || exit 1

echo "=== Pulsar Quality Gate ==="
echo ""

FAILED=0

# Every PHP gate, in one call, from the one list. Not expanded into separate steps
# here: an expansion is a copy, and a copy is what this script is being cured of.
echo "--- PHP: composer qa ---"
if composer qa; then
    echo "[PASS] composer qa"
else
    echo "[FAIL] composer qa"
    FAILED=1
fi
echo ""

# JS/TS lives in package.json, so it cannot be a `composer qa` entry. CI runs these
# four in its `js` job; the names are identical on both sides on purpose.
if [ -d "node_modules" ]; then
    for target in lint format:check typecheck test; do
        echo "--- JS/TS: pnpm $target ---"
        if pnpm "$target"; then
            echo "[PASS] pnpm $target"
        else
            echo "[FAIL] pnpm $target"
            FAILED=1
        fi
        echo ""
    done
else
    echo "--- JS/TS: SKIPPED (node_modules not found, run 'pnpm install') ---"
    echo ""
    echo "    CI runs these four checks unconditionally. Skipping them locally means"
    echo "    this run did NOT cover what CI covers."
    echo ""
fi

echo "=== Quality Gate Summary ==="
if [ $FAILED -eq 0 ]; then
    echo "All checks passed."
    exit 0
fi

echo "One or more checks failed."
exit 1
