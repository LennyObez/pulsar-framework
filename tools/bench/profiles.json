{
  "baseline": {
    "description": "OPcache enabled, JIT off, no preload",
    "ini": {
      "opcache.enable_cli": "1",
      "opcache.jit": "off",
      "opcache.jit_buffer_size": "0"
    },
    "preload": false,
    "optimize": false
  },
  "baseline-optimized": {
    "description": "OPcache + framework cache (config/routes/container)",
    "ini": {
      "opcache.enable_cli": "1",
      "opcache.jit": "off",
      "opcache.jit_buffer_size": "0"
    },
    "preload": false,
    "optimize": true
  },
  "jit-function": {
    "description": "OPcache + JIT function mode",
    "ini": {
      "opcache.enable_cli": "1",
      "opcache.jit": "function",
      "opcache.jit_buffer_size": "128M"
    },
    "preload": false,
    "optimize": false
  },
  "jit-function-optimized": {
    "description": "OPcache + JIT function mode + framework cache",
