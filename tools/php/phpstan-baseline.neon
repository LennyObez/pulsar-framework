###############################################################################
# PHPStan baseline — documented floor entries.
#
# The baseline ratchets toward zero. The entries that remain fall into the TWO
# categories below, which are the accepted floor — each entry carries a
# rationale. Any NEW addition must follow the same pattern: identifier + reason.
# Adding a baseline entry without a rationale is a CI-blocking review red flag.
#
# Category A — PHPStan can statically prove the test assertion is tautological
#              because the production code's return type is narrowed to a
#              literal (e.g. AnonymousIdentity::isAuthenticated() is typed
#              `false`, AnonymousIdentity::hasRole() is typed `false`,
#              authenticated Identity::isAuthenticated() is typed `true`).
#              The tests still defend against future regressions: if someone
#              widens the return type to a real bool, the assertion becomes
#              meaningful again. Removing the test would lose that guard.
#              Annotating each call site with `@phpstan-ignore` moves the
#              suppression closer to the code but does not reduce the total
#              suppression count, so the baseline entry is preferred for
#              auditability (one place to enumerate the contract tests).
#
# Category B — Optional dependency stubs. psy/psysh is a SUGGESTED dependency
#              (composer.json "suggest" section, not "require"). The REPL
#              commands gate every Psy\* call behind class_exists(), so the
#              code is safe to ship without the package. PHPStan cannot see
#              the runtime guard and flags every static reference. Making
#              psysh a hard dependency to please PHPStan would defeat the
#              "optional REPL" contract.
###############################################################################
parameters:
	ignoreErrors:
		# === Category A: tautological test assertions (intentional contract tests) ===
		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertTrue\(\) with true will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 2
			path: ../../tests/Integration/Auth/TwoFactorFlowTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertFalse\(\) with false will always evaluate to false\.$#'
			identifier: staticMethod.impossibleType
			count: 1
			path: ../../tests/Unit/Auth/AuthManagerTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertFalse\(\) with false will always evaluate to false\.$#'
			identifier: staticMethod.impossibleType
			count: 5
			path: ../../tests/Unit/Auth/Identity/AnonymousIdentityTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertSame\(\) with true and true will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: ../../tests/Unit/Auth/Identity/IdentityTest.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertTrue\(\) with true will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: ../../tests/Unit/Auth/Identity/IdentityTest.php

		# The four PsySH entries that used to live here are gone: they suppressed
		# `class.notFound` on Psy\Configuration and Psy\Shell in the two REPL
		# commands, purely because tools/php/stubs/PsySH.php existed on disk but had
		# never been wired into phpstan.neon's scanFiles. Wiring it made the classes
		# known and the suppressions unnecessary — the REPL is now genuinely analysed
		# instead of exempted, and psy/psysh stays a suggested dependency.
