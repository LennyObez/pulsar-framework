includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - ../../src
        - ../../extensions/studio/src
        - ../../extensions/payments/src
        - ../../extensions/psr7-bridge/src
        - ../../extensions/observability-export/src
        - ../../extensions/opentelemetry/src
        - ../../tests
    excludePaths:
        - ../../vendor
    bootstrapFiles:
        - ../../scripts/boundary_check.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
