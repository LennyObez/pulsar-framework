<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    cacheDirectory="../../.psalm-cache"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
>
    <projectFiles>
        <directory name="../../src"/>
        <directory name="../../extensions/accessibility/src"/>
        <directory name="../../extensions/admin/src"/>
        <directory name="../../extensions/analytics/src"/>
        <directory name="../../extensions/cms/src"/>
        <directory name="../../extensions/example/src"/>
        <directory name="../../extensions/form/src"/>
        <directory name="../../extensions/forum/src"/>
        <directory name="../../extensions/graphql/src"/>
        <directory name="../../extensions/grpc/src"/>
        <directory name="../../extensions/mcp-server/src"/>
        <directory name="../../extensions/oauth2/src"/>
        <directory name="../../extensions/observability-export/src"/>
        <directory name="../../extensions/opentelemetry/src"/>
        <directory name="../../extensions/orm/src"/>
        <directory name="../../extensions/payments/src"/>
        <directory name="../../extensions/psr7-bridge/src"/>
        <directory name="../../extensions/social-sso/src"/>
        <directory name="../../extensions/studio/src"/>
        <directory name="../../extensions/webauthn/src"/>
        <ignoreFiles>
            <directory name="../../vendor"/>
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="stubs/Redis.php"/>
        <file name="stubs/Memcached.php"/>
        <file name="stubs/PsySH.php"/>
        <file name="stubs/Amqp.php"/>
        <file name="stubs/AwsSqs.php"/>
        <file name="stubs/GooglePubSub.php"/>
        <file name="stubs/Grpc.php"/>
        <file name="stubs/RoadRunner.php"/>
    </stubs>

    <issueHandlers>
        <!-- Allow mixed types for reflection-based DI and request handling -->
        <MixedAssignment errorLevel="suppress"/>
        <MixedMethodCall errorLevel="suppress"/>
        <MixedArgument errorLevel="suppress"/>
        <MixedReturnStatement errorLevel="suppress"/>

        <!-- Readonly classes are designed for extension in a framework -->
        <ClassMustBeFinal errorLevel="suppress"/>

        <!-- False positives for enum value comparisons -->
        <RedundantCondition errorLevel="suppress"/>

        <!-- Allow array_values on lists for type coercion -->
        <RedundantFunctionCallGivenDocblockType errorLevel="suppress"/>

        <!-- Interface methods overriding PSR interfaces don't need #[Override] -->
        <MissingOverrideAttribute errorLevel="suppress"/>

        <!-- Allow type coercion for docblock types -->
        <RedundantConditionGivenDocblockType errorLevel="suppress"/>
        <ArgumentTypeCoercion errorLevel="suppress"/>

        <!-- File operations can return false -->
        <RiskyTruthyFalsyComparison errorLevel="suppress"/>

        <!-- Psalm 7 beta annotation demands — suppress until stable release.
             These are informational strictness, not real bugs. -->
        <MissingPureAnnotation errorLevel="suppress"/>
        <MissingAbstractPureAnnotation errorLevel="suppress"/>
        <MissingImmutableAnnotation errorLevel="suppress"/>
        <MissingInterfaceImmutableAnnotation errorLevel="suppress"/>

        <!-- Framework classes/methods are consumed by downstream projects,
             not internally — Psalm can't trace those callers -->
        <PossiblyUnusedMethod errorLevel="suppress"/>
        <PossiblyUnusedProperty errorLevel="suppress"/>
        <UnusedClass errorLevel="suppress"/>
        <PossiblyUnusedReturnValue errorLevel="suppress"/>

        <!-- Psalm 7 infers types better, making many @var annotations redundant -->
        <UnnecessaryVarAnnotation errorLevel="suppress"/>

        <!-- Redundant casts that were necessary for older Psalm versions -->
        <RedundantCastGivenDocblockType errorLevel="suppress"/>

        <!-- Framework methods implement interfaces — params are part of the contract
             even when not used in every implementation -->
        <UnusedParam errorLevel="suppress"/>
        <PossiblyUnusedParam errorLevel="suppress"/>
        <UnusedClosureParam errorLevel="suppress"/>
        <UnusedForeachValue errorLevel="suppress"/>

        <!-- Framework constructors/methods are called by DI container or consumers -->
        <UnusedConstructor errorLevel="suppress"/>
        <UnusedMethod errorLevel="suppress"/>

        <!-- PHP 8.x named argument compatibility — implementations may use
             different parameter names than their interfaces -->
        <ParamNameMismatch errorLevel="suppress"/>

        <!-- Related to purity analysis we already suppress -->
        <ImpureMethodCall errorLevel="suppress"/>

        <!-- Psalm 7 taint analysis false positive: checking for formula injection
             characters in CSV export is intentional, not a vulnerability -->
        <InvalidLiteralArgument errorLevel="suppress"/>

        <!-- Implementation types more specific than interface — valid in PHP 8.5
             with covariant/contravariant support -->
        <MoreSpecificImplementedParamType errorLevel="suppress"/>

        <!-- Dynamic includes in templates — structural limitation -->
        <UnresolvableInclude errorLevel="suppress"/>

        <!-- Psalm 6.15 does not yet recognize PHP 8.4 virtual property hooks
             (get-only computed properties with no backing store) -->
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <file name="../../src/Console/Input/ArrayInput.php"/>
            </errorLevel>
        </PropertyNotSetInConstructor>

        <!-- Psalm 7 beta does not yet support PHP 8.5 clone() function syntax
             which preserves the type of $this. PHPStan max is authoritative. -->
        <MoreSpecificReturnType errorLevel="suppress"/>
        <LessSpecificReturnStatement errorLevel="suppress"/>

        <!-- Psalm false positive: ReflectionNamedType::getName() returns string,
             comparison with 'self'/'static'/'parent' is valid runtime check -->
        <TypeDoesNotContainType>
            <errorLevel type="suppress">
                <file name="../../src/Container/Compiler/Pass/OptimizePass.php"/>
            </errorLevel>
        </TypeDoesNotContainType>
    </issueHandlers>
</psalm>
